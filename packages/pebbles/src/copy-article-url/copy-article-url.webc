<!-- src/pebbles/copy-article-url.webc -->
<template
  webc:define="copy-article-url"
  webc:props="{
    url: '',
    label: 'Copy Article URL',
    title: 'Copy URL to clipboard.',
    copiedText: 'Copied',
    copiedDuration: 2000
  }"
>
  <div class="margin--bottom-1 flex flex--middle">
    <div class="helpArticle__copyToClipboard flex flex--middle" data-behavior="clipboard">
      <a
        class="helpArticle__copyLink"
        href=""
        :data-clipboard-text="url"
        data-behavior="clipboard:copy"
        :title="title"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon--link" width="13" height="12.5" viewBox="0 0 13 12.5" aria-hidden="true" focusable="false">
          <path fill="#006E7A" d="M10.159 7.7l1.836-1.837c1.34-1.339 1.34-3.519 0-4.858-1.339-1.34-3.519-1.34-4.858 0l-2.65 2.65c-1.34 1.339-1.34 3.519 0 4.858.198.198.414.366.643.505l1.419-1.419c-.27-.065-.527-.201-.737-.411-.609-.609-.609-1.6 0-2.208l2.65-2.65c.609-.609 1.6-.609 2.208 0 .609.609.609 1.6 0 2.208l-.779.779c.321.755.409 1.585.267 2.383zM2.841 4.801l-1.836 1.836c-1.34 1.339-1.34 3.519 0 4.858 1.339 1.34 3.519 1.34 4.858 0l2.65-2.65c1.34-1.339 1.339-3.519 0-4.858-.198-.198-.414-.366-.643-.505l-1.419 1.419c.27.065.526.201.737.411.609.609.609 1.6 0 2.208l-2.65 2.65c-.609.609-1.6.609-2.208 0-.609-.609-.609-1.6 0-2.208l.779-.779c-.321-.755-.41-1.586-.267-2.383z"></path>
        </svg>
        <span><span webc:raw="label"></span></span>
      </a>

      <div
        class="helpArticle__copyAlert badge badge--info margin--left-c2"
        data-behavior="clipboard:message"
        hidden
        aria-live="polite"
      >
        <span webc:raw="copiedText"></span>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.currentScript?.closest('[data-behavior="clipboard"]');
      if (!root) return;

      const link = root.querySelector('[data-behavior="clipboard:copy"]');
      const msg = root.querySelector('[data-behavior="clipboard:message"]');
      if (!link || !msg) return;

      const showCopied = (duration = 2000) => {
        msg.hidden = false;
        window.clearTimeout(showCopied._t);
        showCopied._t = window.setTimeout(() => (msg.hidden = true), duration);
      };

      link.addEventListener("click", async (e) => {
        e.preventDefault();

        // Prefer explicit prop (data-clipboard-text), fallback to current page URL
        const text = link.getAttribute("data-clipboard-text") || window.location.href;

        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            // Fallback for older browsers
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
          }
          showCopied(Number(root.getAttribute("data-copied-duration")) || 2000);
        } catch {
          // If copy fails, you can choose to surface a different message
          // For now, do nothing (keeps UX calm)
        }
      });
    })();
  </script>
</template>
